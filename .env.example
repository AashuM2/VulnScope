# Copy these values into your shell environment or a local .env file loader.
# Do not commit real credentials.
VULNSCOPE_DB_HOST=127.0.0.1
VULNSCOPE_DB_PORT=3306
VULNSCOPE_DB_USER=root
VULNSCOPE_DB_PASSWORD=replace_with_your_mysql_password
VULNSCOPE_DB_NAME=vulnscope
VULNSCOPE_SECRET_KEY=replace_with_a_long_random_secret
# Set to 1 ONLY when the app is served over HTTPS. Keep 0 for local HTTP development.
VULNSCOPE_HTTPS=0
FLASK_DEBUG=0
